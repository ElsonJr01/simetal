# Copie para .env. Todas as variáveis têm o prefixo SIMETAL_
SIMETAL_ENV=development
# Em produção: chave aleatória com 32+ caracteres (o app se recusa a iniciar sem ela)
SIMETAL_SECRET_KEY=gere-uma-chave-longa-e-aleatoria-com-32-ou-mais-caracteres
# Local (padrão): SQLite. Produção/Vercel: connection string do Neon (com ?sslmode=require)
SIMETAL_DATABASE_URL=sqlite:///./simetal.db
# SIMETAL_DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# Administrador inicial (criado na partida se não existir). Defina os DOIS ou nenhum.
# Depois de entrar, troque a senha pelo painel e remova SIMETAL_ADMIN_PASSWORD do ambiente.
# SIMETAL_ADMIN_EMAIL=voce@exemplo.com
# SIMETAL_ADMIN_PASSWORD=uma-senha-forte-aqui

SIMETAL_ALLOW_REGISTRATION=true      # valor inicial; o admin alterna em /admin
SIMETAL_AUTO_CREATE_TABLES=true      # cria tabelas/colunas na partida (teste); em produção use Alembic
SIMETAL_LOCKOUT_ATTEMPTS=5
SIMETAL_LOCKOUT_MINUTES=15
SIMETAL_INTEGRATIONS_ENABLED=true
SIMETAL_HTTP_TIMEOUT=6
SIMETAL_RAIN_ALERT_MM=20
SIMETAL_VLIBRAS_ENABLED=true
SIMETAL_MASCOT_ENABLED=true
SIMETAL_LOG_LEVEL=INFO
