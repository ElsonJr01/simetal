# Copie para .env. Todas as variáveis têm o prefixo SIMETAL_
SIMETAL_ENV=development
SIMETAL_SECRET_KEY=gere-uma-chave-longa-e-aleatoria
# Local (padrão): SQLite. Produção/Vercel: connection string do Neon (com ?sslmode=require)
SIMETAL_DATABASE_URL=sqlite:///./simetal.db
# SIMETAL_DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require
SIMETAL_ALLOW_REGISTRATION=true
SIMETAL_AUTO_CREATE_TABLES=true
SIMETAL_INTEGRATIONS_ENABLED=true
SIMETAL_HTTP_TIMEOUT=6
SIMETAL_RAIN_ALERT_MM=20
